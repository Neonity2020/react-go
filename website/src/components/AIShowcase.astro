---
import { translations } from "../i18n/translations";
const t = translations;
---

<section id="ai" class="py-24 px-6 bg-bg-card/30">
  <div class="max-w-6xl mx-auto">
    <!-- EN header -->
    <div data-lang="en">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-3">{t.en.aiShowcase.title}</h2>
      <p class="text-text-secondary text-center mb-16 max-w-2xl mx-auto">{t.en.aiShowcase.subtitle}</p>
    </div>
    <!-- ZH header -->
    <div data-lang="zh">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-3">{t.zh.aiShowcase.title}</h2>
      <p class="text-text-secondary text-center mb-16 max-w-2xl mx-auto">{t.zh.aiShowcase.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Winrate -->
      <div class="reveal rounded-2xl p-8 bg-bg-card border border-border">
        <div class="w-12 h-12 rounded-xl bg-teal/10 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-teal" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941"/>
          </svg>
        </div>
        <!-- Mini winrate chart SVG -->
        <svg viewBox="0 0 200 60" class="w-full mb-6 opacity-60">
          <defs>
            <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#2f766e" stop-opacity="0.3" />
              <stop offset="100%" stop-color="#2f766e" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path d="M0 30 L20 25 L40 28 L60 20 L80 22 L100 15 L120 18 L140 10 L160 12 L180 8 L200 5" fill="none" stroke="#2f766e" stroke-width="2" />
          <path d="M0 30 L20 25 L40 28 L60 20 L80 22 L100 15 L120 18 L140 10 L160 12 L180 8 L200 5 L200 60 L0 60Z" fill="url(#chartGrad)" />
        </svg>
        <div data-lang="en">
          <h3 class="text-lg font-semibold mb-2">{t.en.aiShowcase.winrate}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{t.en.aiShowcase.winrateDesc}</p>
        </div>
        <div data-lang="zh">
          <h3 class="text-lg font-semibold mb-2">{t.zh.aiShowcase.winrate}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{t.zh.aiShowcase.winrateDesc}</p>
        </div>
      </div>

      <!-- Candidates -->
      <div class="reveal rounded-2xl p-8 bg-bg-card border border-border">
        <div class="w-12 h-12 rounded-xl bg-wood-light/10 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-wood-light" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
          </svg>
        </div>
        <!-- Mini board with candidate markers -->
        <svg viewBox="0 0 160 160" class="w-full mb-6 opacity-70">
          <defs>
            <linearGradient id="miniBoard" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#e7bf72" />
              <stop offset="100%" stop-color="#c89345" />
            </linearGradient>
          </defs>
          <rect width="160" height="160" rx="8" fill="url(#miniBoard)" />
          <!-- Grid -->
          {Array.from({ length: 5 }, (_, i) => (
            <>
              <line x1={30 + i * 25} y1="30" x2={30 + i * 25} y2="130" stroke="#8B6B2F" stroke-width="0.6" />
              <line x1="30" y1={30 + i * 25} x2="130" y2={30 + i * 25} stroke="#8B6B2F" stroke-width="0.6" />
            </>
          ))}
          <!-- Candidate circles -->
          <circle cx="80" cy="55" r="10" fill="#22c55e" fill-opacity="0.3" stroke="#22c55e" stroke-width="1.5" />
          <text x="80" y="59" text-anchor="middle" fill="#22c55e" font-size="8" font-weight="bold">58%</text>
          <circle cx="55" cy="80" r="8" fill="#22c55e" fill-opacity="0.2" stroke="#22c55e" stroke-width="1" />
          <text x="55" y="83" text-anchor="middle" fill="#22c55e" font-size="7">23%</text>
          <circle cx="105" cy="80" r="7" fill="#22c55e" fill-opacity="0.15" stroke="#22c55e" stroke-width="1" />
          <text x="105" y="83" text-anchor="middle" fill="#22c55e" font-size="6">12%</text>
          <circle cx="80" cy="105" r="6" fill="#22c55e" fill-opacity="0.1" stroke="#22c55e" stroke-width="1" />
          <text x="80" y="108" text-anchor="middle" fill="#22c55e" font-size="5">7%</text>
        </svg>
        <div data-lang="en">
          <h3 class="text-lg font-semibold mb-2">{t.en.aiShowcase.candidates}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{t.en.aiShowcase.candidatesDesc}</p>
        </div>
        <div data-lang="zh">
          <h3 class="text-lg font-semibold mb-2">{t.zh.aiShowcase.candidates}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{t.zh.aiShowcase.candidatesDesc}</p>
        </div>
      </div>

      <!-- PV -->
      <div class="reveal rounded-2xl p-8 bg-bg-card border border-border">
        <div class="w-12 h-12 rounded-xl bg-teal-light/10 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-teal-light" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/>
          </svg>
        </div>
        <!-- PV visualization -->
        <svg viewBox="0 0 160 160" class="w-full mb-6 opacity-70">
          <defs>
            <linearGradient id="miniBoard2" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#e7bf72" />
              <stop offset="100%" stop-color="#c89345" />
            </linearGradient>
          </defs>
          <rect width="160" height="160" rx="8" fill="url(#miniBoard2)" />
          {Array.from({ length: 5 }, (_, i) => (
            <>
              <line x1={30 + i * 25} y1="30" x2={30 + i * 25} y2="130" stroke="#8B6B2F" stroke-width="0.6" />
              <line x1="30" y1={30 + i * 25} x2="130" y2={30 + i * 25} stroke="#8B6B2F" stroke-width="0.6" />
            </>
          ))}
          <!-- PV numbered stones -->
          <circle cx="80" cy="55" r="9" fill="#111" fill-opacity="0.6" stroke="#22c55e" stroke-width="1.5" />
          <text x="80" y="58.5" text-anchor="middle" fill="white" font-size="9" font-weight="bold">1</text>
          <circle cx="55" cy="80" r="9" fill="#ddd" fill-opacity="0.5" stroke="#22c55e" stroke-width="1.5" />
          <text x="55" y="83.5" text-anchor="middle" fill="#333" font-size="9" font-weight="bold">2</text>
          <circle cx="105" cy="80" r="9" fill="#111" fill-opacity="0.6" stroke="#22c55e" stroke-width="1.5" />
          <text x="105" y="83.5" text-anchor="middle" fill="white" font-size="9" font-weight="bold">3</text>
          <circle cx="80" cy="105" r="9" fill="#ddd" fill-opacity="0.5" stroke="#22c55e" stroke-width="1.5" />
          <text x="80" y="108.5" text-anchor="middle" fill="#333" font-size="9" font-weight="bold">4</text>
        </svg>
        <div data-lang="en">
          <h3 class="text-lg font-semibold mb-2">{t.en.aiShowcase.pv}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{t.en.aiShowcase.pvDesc}</p>
        </div>
        <div data-lang="zh">
          <h3 class="text-lg font-semibold mb-2">{t.zh.aiShowcase.pv}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{t.zh.aiShowcase.pvDesc}</p>
        </div>
      </div>
    </div>
  </div>
</section>
