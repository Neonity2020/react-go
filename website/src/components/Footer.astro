---
import { translations } from "../i18n/translations";
const t = translations;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="py-12 px-6 border-t border-border">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <img src={`${base}/logo.png`} alt="React Go" class="w-7 h-7 rounded-lg" />
          <span class="text-base font-bold gradient-text">React Go</span>
        </div>
        <p class="text-sm text-text-muted leading-relaxed" data-lang="en">{t.en.footer.description}</p>
        <p class="text-sm text-text-muted leading-relaxed" data-lang="zh">{t.zh.footer.description}</p>
      </div>

      <!-- Links -->
      <div>
        <h4 class="text-sm font-semibold mb-4" data-lang="en">{t.en.footer.links}</h4>
        <h4 class="text-sm font-semibold mb-4" data-lang="zh">{t.zh.footer.links}</h4>
        <ul class="space-y-2">
          <li>
            <a href="https://github.com/Neonity2020/react-go" target="_blank" rel="noopener noreferrer" class="text-sm text-text-muted hover:text-text-primary transition-colors" data-lang="en">{t.en.footer.github}</a>
            <a href="https://github.com/Neonity2020/react-go" target="_blank" rel="noopener noreferrer" class="text-sm text-text-muted hover:text-text-primary transition-colors" data-lang="zh">{t.zh.footer.github}</a>
          </li>
          <li>
            <a href="https://github.com/Neonity2020/react-go/issues" target="_blank" rel="noopener noreferrer" class="text-sm text-text-muted hover:text-text-primary transition-colors" data-lang="en">{t.en.footer.issues}</a>
            <a href="https://github.com/Neonity2020/react-go/issues" target="_blank" rel="noopener noreferrer" class="text-sm text-text-muted hover:text-text-primary transition-colors" data-lang="zh">{t.zh.footer.issues}</a>
          </li>
        </ul>
      </div>

      <!-- Community -->
      <div>
        <h4 class="text-sm font-semibold mb-4" data-lang="en">{t.en.footer.community}</h4>
        <h4 class="text-sm font-semibold mb-4" data-lang="zh">{t.zh.footer.community}</h4>
        <ul class="space-y-2">
          <li>
            <span class="text-sm text-text-muted" data-lang="en">{t.en.footer.license}</span>
            <span class="text-sm text-text-muted" data-lang="zh">{t.zh.footer.license}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-text-muted">&copy; {new Date().getFullYear()} React Go</p>
      <p class="text-xs text-text-muted">
        <span data-lang="en">{t.en.footer.builtWith}</span>
        <span data-lang="zh">{t.zh.footer.builtWith}</span>
      </p>
    </div>
  </div>
</footer>
