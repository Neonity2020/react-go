---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const katagoModelUrl = `${base}/katago/katago-small.bin.gz`;
---

<section id="review" class="py-24 px-6 bg-bg-card/30" data-katago-model-url={katagoModelUrl}>
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-10 items-center">
      <div class="reveal">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-teal/25 bg-teal/10 text-teal-light text-sm font-medium mb-5">
          <span class="h-2 w-2 rounded-full bg-teal-light"></span>
          <span data-lang="en">Web KataGo mini match</span>
          <span data-lang="zh">网页 KataGo 迷你对局</span>
        </div>

        <div data-lang="en">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Play a few moves against KataGo in the browser</h2>
          <p class="text-text-secondary leading-relaxed mb-6">
            Try a lightweight 9×9 game directly on the web. Click the board to play black; a browser-based KataGo neural network engine (TensorFlow.js) answers as white, while the full-strength KataGo engine remains available in the desktop app.
          </p>
        </div>
        <div data-lang="zh">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">在网页上与 KataGo 简单下几手</h2>
          <p class="text-text-secondary leading-relaxed mb-6">
            直接在网页端试玩轻量 9 路棋。点击棋盘执黑落子，内置 KataGo 神经网络引擎（TensorFlow.js）会执白回应；完整强度的 KataGo 引擎仍由桌面版提供。
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-7">
          <div class="rounded-xl border border-border bg-bg-card p-4">
            <div class="text-2xl font-bold text-text-primary">9×9</div>
            <div class="text-sm text-text-muted" data-lang="en">Quick browser game</div>
            <div class="text-sm text-text-muted" data-lang="zh">网页快速对弈</div>
          </div>
          <div class="rounded-xl border border-border bg-bg-card p-4">
            <div class="text-2xl font-bold text-text-primary">TF.js</div>
            <div class="text-sm text-text-muted" data-lang="en">Local AI response</div>
            <div class="text-sm text-text-muted" data-lang="zh">本地 AI 应手</div>
          </div>
          <div class="rounded-xl border border-border bg-bg-card p-4">
            <div class="text-2xl font-bold text-text-primary">KataGo</div>
            <div class="text-sm text-text-muted" data-lang="en">Full engine on desktop</div>
            <div class="text-sm text-text-muted" data-lang="zh">桌面端完整引擎</div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <button
            type="button"
            id="review-new-game"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-teal hover:bg-teal-light text-white font-semibold transition-all shadow-lg shadow-teal/20 cursor-pointer"
          >
            <span data-lang="en">New web game</span>
            <span data-lang="zh">重新开始网页对局</span>
          </button>
          <a
            href="https://github.com/Neonity2020/react-go/releases/latest"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl border border-border text-text-secondary hover:text-text-primary hover:border-text-muted font-medium transition-all"
          >
            <span data-lang="en">Download full desktop app</span>
            <span data-lang="zh">下载完整桌面版</span>
          </a>
        </div>
      </div>

      <div class="reveal rounded-2xl border border-border bg-bg-card overflow-hidden shadow-2xl">
        <div class="flex items-center justify-between gap-4 px-5 py-4 border-b border-border">
          <div>
            <div class="font-semibold" data-lang="en">Web Game</div>
            <div class="font-semibold" data-lang="zh">网页对局</div>
            <div id="webgpu-status" class="text-xs text-text-muted mt-1">Loading...</div>
          </div>
          <div class="px-3 py-1 rounded-full bg-teal/10 text-teal-light text-xs font-semibold">
            <span data-lang="en">Move</span>
            <span data-lang="zh">手数</span>
            <span id="review-move">0</span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-[1fr_220px] gap-0">
          <div class="p-5">
            <button
              type="button"
              id="review-board"
              class="relative block w-full aspect-square rounded-xl overflow-hidden bg-wood-light shadow-inner cursor-pointer"
              aria-label="Play a move on the 9 by 9 Go board"
            >
              <svg viewBox="0 0 400 400" class="absolute inset-0 h-full w-full pointer-events-none">
                <defs>
                  <linearGradient id="reviewBoardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#e7bf72" />
                    <stop offset="100%" stop-color="#c89345" />
                  </linearGradient>
                  <radialGradient id="reviewBlackStone" cx="40%" cy="35%">
                    <stop offset="0%" stop-color="#555" />
                    <stop offset="100%" stop-color="#111" />
                  </radialGradient>
                  <radialGradient id="reviewWhiteStone" cx="35%" cy="30%">
                    <stop offset="0%" stop-color="#fff" />
                    <stop offset="80%" stop-color="#c8c4bc" />
                  </radialGradient>
                  <filter id="reviewStoneShadow">
                    <feDropShadow dx="1" dy="2" stdDeviation="2" flood-opacity="0.3" />
                  </filter>
                </defs>
                <rect width="400" height="400" fill="url(#reviewBoardGrad)" />
                {Array.from({ length: 9 }, (_, i) => {
                  const pos = 44 + i * 39;
                  return (
                    <>
                      <line x1={pos} y1="44" x2={pos} y2="356" stroke="#8B6B2F" stroke-width="1" />
                      <line x1="44" y1={pos} x2="356" y2={pos} stroke="#8B6B2F" stroke-width="1" />
                    </>
                  );
                })}
                {[2, 4, 6].map((x) =>
                  [2, 4, 6].map((y) => (
                    <circle cx={44 + x * 39} cy={44 + y * 39} r="3.5" fill="#8B6B2F" />
                  ))
                )}
                <g id="review-candidates"></g>
                <g id="review-stones"></g>
                <circle id="review-hover" cx="-20" cy="-20" r="15" fill="rgba(17,17,17,0.22)" stroke="rgba(17,17,17,0.55)" stroke-width="1.5"></circle>
              </svg>
            </button>
            <div class="mt-4 flex flex-row gap-2">
              <button
                type="button"
                id="review-pass"
                class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-border text-text-secondary hover:text-text-primary hover:border-text-muted font-medium transition-all cursor-pointer flex-1"
              >
                <span data-lang="en">Pass</span>
                <span data-lang="zh">虚手</span>
              </button>
              <button
                type="button"
                id="review-resign"
                class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-red-500/30 text-red-400 hover:bg-red-500/10 hover:border-red-500/50 font-medium transition-all cursor-pointer flex-1"
              >
                <span data-lang="en">Resign</span>
                <span data-lang="zh">认输</span>
              </button>
            </div>
          </div>

          <aside class="border-t md:border-t-0 md:border-l border-border p-5">
            <div class="mb-6">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm text-text-secondary" data-lang="en">Black outlook</span>
                <span class="text-sm text-text-secondary" data-lang="zh">黑棋形势</span>
                <span id="review-winrate" class="text-sm font-semibold text-teal-light">50.0%</span>
              </div>
              <svg id="review-chart" viewBox="0 0 200 72" class="w-full h-20">
                <path id="review-chart-fill" d="" fill="rgba(47, 118, 110, 0.18)"></path>
                <path id="review-chart-line" d="" fill="none" stroke="#3a9189" stroke-width="3" stroke-linecap="round"></path>
              </svg>
            </div>

            <div class="mb-6">
              <h3 class="text-sm font-semibold mb-3" data-lang="en">AI candidate moves</h3>
              <h3 class="text-sm font-semibold mb-3" data-lang="zh">AI 推荐着点</h3>
              <div id="review-candidate-list" class="space-y-2"></div>
            </div>

            <div class="rounded-xl bg-bg-dark/60 border border-border p-4">
              <div class="text-sm font-semibold mb-2" data-lang="en">Last move</div>
              <div class="text-sm font-semibold mb-2" data-lang="zh">最近一手</div>
              <div id="review-pv" class="text-sm text-text-secondary">Black to play</div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { createKatagoWebGpuRuntime } from "../lib/katago/workerRuntime";

  // ============ Constants ============
  const BOARD_SIZE = 9;
  const EMPTY = null;
  const BLACK = 'black';
  const WHITE = 'white';
  const LABELS = "ABCDEFGHJ";
  const KOMI = 6.5;
  const BOARD_ORIGIN = 44;
  const GRID_STEP = 39;

  // ============ Types ============
  type Stone = 'black' | 'white';
  type Board = (Stone | null)[][];
  type Position = { row: number; col: number };

  // ============ DOM Elements ============
  const boardButton = document.getElementById("review-board") as HTMLButtonElement;
  const reviewSection = document.getElementById("review") as HTMLElement;
  const katagoModelUrl = reviewSection?.dataset.katagoModelUrl || "";
  const newGameButton = document.getElementById("review-new-game") as HTMLButtonElement;
  const passButton = document.getElementById("review-pass") as HTMLButtonElement;
  const resignButton = document.getElementById("review-resign") as HTMLButtonElement;
  const statusEl = document.getElementById("webgpu-status") as HTMLElement;
  const moveEl = document.getElementById("review-move") as HTMLElement;
  const winrateEl = document.getElementById("review-winrate") as HTMLElement;
  const stonesGroup = document.getElementById("review-stones") as SVGGElement;
  const candidateGroup = document.getElementById("review-candidates") as SVGGElement;
  const candidateList = document.getElementById("review-candidate-list") as HTMLDivElement;
  const pvEl = document.getElementById("review-pv") as HTMLElement;
  const chartLine = document.getElementById("review-chart-line") as SVGPathElement;
  const chartFill = document.getElementById("review-chart-fill") as SVGPathElement;
  const hoverStone = document.getElementById("review-hover") as SVGCircleElement;

  const aiRuntime = createKatagoWebGpuRuntime();

  // ============ Game State ============
  let board: Board = createEmptyBoard();
  let currentPlayer: Stone = BLACK;
  let koPoint: Position | null = null;
  let passCount = 0;
  let gameOver = false;
  let lastMove: Position | null = null;
  let playerColor: Stone = BLACK;
  let aiColor: Stone = WHITE;
  let moveNumber = 0;
  let aiThinking = false;
  let modelReady = false;
  let modelError = "";
  let moveHistory: Array<{ index: number; color: number }> = [];
  let winrateHistory: number[] = [50];

  function createEmptyBoard(): Board {
    return Array.from({ length: BOARD_SIZE }, () => Array(BOARD_SIZE).fill(EMPTY));
  }

  function cloneBoard(b: Board): Board {
    return b.map(row => [...row]);
  }

  // ============ Position Utilities ============
  function posKey(p: Position): string {
    return `${p.row},${p.col}`;
  }

  function getNeighbors(pos: Position): Position[] {
    const { row, col } = pos;
    const result: Position[] = [];
    if (row > 0) result.push({ row: row - 1, col });
    if (row < BOARD_SIZE - 1) result.push({ row: row + 1, col });
    if (col > 0) result.push({ row, col: col - 1 });
    if (col < BOARD_SIZE - 1) result.push({ row, col: col + 1 });
    return result;
  }

  function pixelFor(v: number): number {
    return BOARD_ORIGIN + v * GRID_STEP;
  }

  function formatPoint(pos: Position): string {
    return `${LABELS[pos.col]}${BOARD_SIZE - pos.row}`;
  }

  // ============ Go Engine (from engine.ts) ============
  function simulateMove(pos: Position, player: Stone): {
    valid: boolean;
    nextBoard: Board;
    capturedCount: number;
    capturedSingle: Position | null;
    nextKoPoint: Position | null;
  } {
    const { row, col } = pos;

    if (row < 0 || row >= BOARD_SIZE || col < 0 || col >= BOARD_SIZE) {
      return { valid: false, nextBoard: board, capturedCount: 0, capturedSingle: null, nextKoPoint: null };
    }
    if (board[row][col] !== EMPTY) {
      return { valid: false, nextBoard: board, capturedCount: 0, capturedSingle: null, nextKoPoint: null };
    }
    if (koPoint && koPoint.row === row && koPoint.col === col) {
      return { valid: false, nextBoard: board, capturedCount: 0, capturedSingle: null, nextKoPoint: null };
    }

    const newBoard = cloneBoard(board);
    newBoard[row][col] = player;
    const opponent: Stone = player === BLACK ? WHITE : BLACK;

    let capturedCount = 0;
    let capturedSingle: Position | null = null;
    for (const neighbor of getNeighbors(pos)) {
      if (newBoard[neighbor.row][neighbor.col] === opponent) {
        const group = getGroupWithBoard(newBoard, neighbor);
        if (getLibertiesWithBoard(newBoard, group) === 0) {
          capturedCount += group.length;
          if (group.length === 1) capturedSingle = group[0];
          for (const p of group) {
            newBoard[p.row][p.col] = EMPTY;
          }
        }
      }
    }

    const ownGroup = getGroupWithBoard(newBoard, pos);
    if (getLibertiesWithBoard(newBoard, ownGroup) === 0) {
      return { valid: false, nextBoard: board, capturedCount: 0, capturedSingle: null, nextKoPoint: null };
    }

    let nextKoPoint: Position | null = null;
    if (capturedCount === 1 && capturedSingle && ownGroup.length === 1 && getLibertiesWithBoard(newBoard, ownGroup) === 1) {
      nextKoPoint = capturedSingle;
    }

    return { valid: true, nextBoard: newBoard, capturedCount, capturedSingle, nextKoPoint };
  }

  function isValidMove(pos: Position, player: Stone = currentPlayer): boolean {
    return simulateMove(pos, player).valid;
  }

  // Helper functions that take board as parameter
  function getGroupWithBoard(b: Board, pos: Position): Position[] {
    const stone = b[pos.row][pos.col];
    if (!stone) return [];

    const visited = new Set<string>();
    const group: Position[] = [];
    const queue: Position[] = [pos];

    while (queue.length > 0) {
      const curr = queue.pop()!;
      const key = posKey(curr);
      if (visited.has(key)) continue;
      visited.add(key);
      group.push(curr);

      for (const neighbor of getNeighbors(curr)) {
        const nKey = posKey(neighbor);
        if (!visited.has(nKey) && b[neighbor.row][neighbor.col] === stone) {
          queue.push(neighbor);
        }
      }
    }
    return group;
  }

  function getLibertiesWithBoard(b: Board, group: Position[]): number {
    const libertySet = new Set<string>();
    for (const pos of group) {
      for (const neighbor of getNeighbors(pos)) {
        if (b[neighbor.row][neighbor.col] === EMPTY) {
          libertySet.add(posKey(neighbor));
        }
      }
    }
    return libertySet.size;
  }

  function getLegalMoves(player: Stone = currentPlayer): Position[] {
    const moves: Position[] = [];
    for (let r = 0; r < BOARD_SIZE; r++) {
      for (let c = 0; c < BOARD_SIZE; c++) {
        if (isValidMove({ row: r, col: c }, player)) {
          moves.push({ row: r, col: c });
        }
      }
    }
    return moves;
  }

  function chooseFallbackMove(moves: Position[], player: Stone): Position | null {
    if (moves.length === 0) return null;

    const opponent = player === BLACK ? WHITE : BLACK;
    let bestMove = moves[0];
    let bestScore = -Infinity;

    for (const pos of moves) {
      const move = simulateMove(pos, player);
      if (!move.valid) continue;

      let score = move.capturedCount * 80;
      const edgeDistance = Math.min(pos.row, pos.col, BOARD_SIZE - 1 - pos.row, BOARD_SIZE - 1 - pos.col);
      score += edgeDistance * 8;
      score -= Math.abs(pos.row - 4) + Math.abs(pos.col - 4);

      for (const neighbor of getNeighbors(pos)) {
        if (board[neighbor.row][neighbor.col] === player) score += 6;
        if (board[neighbor.row][neighbor.col] === opponent) score += 3;
      }

      if (score > bestScore) {
        bestScore = score;
        bestMove = pos;
      }
    }

    return bestMove;
  }

  function playAiFallbackMove(label = "fallback"): boolean {
    if (gameOver || currentPlayer !== aiColor) return false;

    const legalMoves = getLegalMoves(aiColor);
    const fallback = chooseFallbackMove(legalMoves, aiColor);
    if (fallback) {
      placeStone(fallback);
      statusEl.textContent = `AI: ${formatPoint(fallback)} · ${label}`;
      pvEl.textContent = `AI: ${formatPoint(fallback)} · ${label}`;
      return true;
    }

    passMove();
    statusEl.textContent = "AI passed";
    pvEl.textContent = "AI passed";
    return true;
  }

  function placeStone(pos: Position): boolean {
    if (gameOver) return false;
    const move = simulateMove(pos, currentPlayer);
    if (!move.valid) return false;
    const opponent: Stone = currentPlayer === BLACK ? WHITE : BLACK;

    board = move.nextBoard;
    koPoint = move.nextKoPoint;
    lastMove = pos;
    passCount = 0;
    moveHistory.push({ index: pos.row * BOARD_SIZE + pos.col, color: currentPlayer === BLACK ? 1 : 2 });
    currentPlayer = opponent;
    moveNumber++;

    return true;
  }

  function passMove(): void {
    if (gameOver) return;

    passCount++;
    koPoint = null;
    lastMove = null;
    currentPlayer = currentPlayer === BLACK ? WHITE : BLACK;

    if (passCount >= 2) {
      gameOver = true;
    }
  }

  function calculateScore(): { blackScore: number; whiteScore: number; winner: Stone | 'tie' } {
    let blackStones = 0;
    let whiteStones = 0;
    let blackTerritory = 0;
    let whiteTerritory = 0;

    // Count stones
    for (let r = 0; r < BOARD_SIZE; r++) {
      for (let c = 0; c < BOARD_SIZE; c++) {
        if (board[r][c] === BLACK) blackStones++;
        else if (board[r][c] === WHITE) whiteStones++;
      }
    }

    // Flood fill for territory
    const visited = new Set<string>();
    for (let r = 0; r < BOARD_SIZE; r++) {
      for (let c = 0; c < BOARD_SIZE; c++) {
        const key = `${r},${c}`;
        if (board[r][c] !== EMPTY || visited.has(key)) continue;

        const region: Position[] = [];
        const borders = new Set<Stone>();
        const queue: Position[] = [{ row: r, col: c }];
        visited.add(key);

        while (queue.length > 0) {
          const curr = queue.pop()!;
          region.push(curr);
          for (const nb of getNeighbors(curr)) {
            const nbKey = posKey(nb);
            if (board[nb.row][nb.col] === EMPTY && !visited.has(nbKey)) {
              visited.add(nbKey);
              queue.push(nb);
            } else if (board[nb.row][nb.col] !== EMPTY) {
              borders.add(board[nb.row][nb.col] as Stone);
            }
          }
        }

        if (borders.size === 1) {
          if (borders.has(BLACK)) blackTerritory += region.length;
          else whiteTerritory += region.length;
        }
      }
    }

    const blackScore = blackStones + blackTerritory;
    const whiteScore = whiteStones + whiteTerritory + KOMI;

    let winner: Stone | 'tie';
    if (blackScore > whiteScore) winner = BLACK;
    else if (whiteScore > blackScore) winner = WHITE;
    else winner = 'tie';

    return { blackScore, whiteScore, winner };
  }

  // ============ Rendering ============
  function renderStones(): void {
    stonesGroup.innerHTML = "";

    for (let r = 0; r < BOARD_SIZE; r++) {
      for (let c = 0; c < BOARD_SIZE; c++) {
        const stone = board[r][c];
        if (!stone) continue;

        const isLast = lastMove?.row === r && lastMove?.col === c;
        stonesGroup.innerHTML += `
          <circle cx="${pixelFor(c)}" cy="${pixelFor(r)}" r="16"
            fill="${stone === BLACK ? "url(#reviewBlackStone)" : "url(#reviewWhiteStone)"}"
            filter="url(#reviewStoneShadow)"></circle>
          ${isLast ? `<circle cx="${pixelFor(c)}" cy="${pixelFor(r)}" r="5"
            fill="none" stroke="${stone === BLACK ? "white" : "#2f766e"}" stroke-width="2"></circle>` : ''}
        `;
      }
    }
  }

  function renderCandidates(moves: { pos: Position; winrate: number }[]): void {
    candidateGroup.innerHTML = "";
    candidateList.innerHTML = "";

    if (!moves || moves.length === 0) return;

    moves.slice(0, 4).forEach((m, i) => {
      const { row, col } = m.pos;
      candidateGroup.innerHTML += `
        <circle cx="${pixelFor(col)}" cy="${pixelFor(row)}" r="${18 - i * 2}"
          fill="rgba(34,197,94,0.14)" stroke="#22c55e" stroke-width="2"></circle>
        <text x="${pixelFor(col)}" y="${pixelFor(row) + 4}" text-anchor="middle"
          fill="#dcfce7" font-size="11" font-weight="700">${Math.round(m.winrate)}%</text>
      `;
      candidateList.innerHTML += `
        <div class="flex items-center justify-between rounded-lg bg-bg-dark/60 border border-border px-3 py-2">
          <span class="text-sm font-medium">${i + 1}. ${formatPoint(m.pos)}</span>
          <span class="text-sm text-teal-light">${Math.round(m.winrate)}%</span>
        </div>
      `;
    });
  }

  function renderWinrateChart(): void {
    if (winrateHistory.length < 2) {
      chartLine.setAttribute("d", "");
      chartFill.setAttribute("d", "");
      return;
    }

    const maxX = 200;
    const maxY = 72;
    const points = winrateHistory.map((winrate, i) => {
      const x = winrateHistory.length === 1 ? 0 : (i / (winrateHistory.length - 1)) * maxX;
      const y = maxY - (Math.max(0, Math.min(100, winrate)) / 100) * maxY;
      return { x, y };
    });
    const line = points.map((p, i) => `${i === 0 ? "M" : "L"} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(" ");
    const fill = `${line} L ${maxX} ${maxY} L 0 ${maxY} Z`;
    chartLine.setAttribute("d", line);
    chartFill.setAttribute("d", fill);
  }

  function updateUI(): void {
    moveEl.textContent = String(moveNumber);

    if (gameOver) {
      const score = calculateScore();
      const playerWins = score.winner === playerColor;

      if (playerWins) {
        statusEl.textContent = `You win! ${score.blackScore} vs ${score.whiteScore.toFixed(1)}`;
        pvEl.textContent = "🏆 You win!";
      } else if (score.winner === 'tie') {
        statusEl.textContent = "Draw";
        pvEl.textContent = "Draw";
      } else {
        statusEl.textContent = `You lose. ${score.blackScore} vs ${score.whiteScore.toFixed(1)}`;
        pvEl.textContent = "AI wins";
      }
    } else if (aiThinking) {
      statusEl.textContent = "AI thinking...";
      pvEl.textContent = "AI thinking...";
    } else if (currentPlayer === playerColor) {
      statusEl.textContent = modelReady ? "Your turn" : "Your turn · fallback AI";
    } else {
      statusEl.textContent = "AI thinking...";
    }

    renderStones();
    renderWinrateChart();
  }

  // ============ AI Logic ============
  async function aiMove(): Promise<void> {
    if (gameOver || currentPlayer !== aiColor || aiThinking) return;

    aiThinking = true;
    boardButton.disabled = true;
    updateUI();

    const legalMoves = getLegalMoves();
    if (legalMoves.length === 0) {
      passMove();
      aiThinking = false;
      boardButton.disabled = false;
      updateUI();
      return;
    }

    // Convert board to flat array for KataGo
    const boardFlat = new Int8Array(BOARD_SIZE * BOARD_SIZE);
    for (let r = 0; r < BOARD_SIZE; r++) {
      for (let c = 0; c < BOARD_SIZE; c++) {
        const idx = r * BOARD_SIZE + c;
        boardFlat[idx] = board[r][c] === BLACK ? 1 : board[r][c] === WHITE ? 2 : 0;
      }
    }

    const moveIndices = legalMoves.map(p => p.row * BOARD_SIZE + p.col);
    try {
      if (!modelReady) {
        throw new Error(modelError || "KataGo model not ready");
      }

      const analysis = await Promise.race([
        aiRuntime.analyze({
          board: boardFlat,
          color: aiColor === BLACK ? 1 : 2,
          legalIndices: moveIndices,
          moveCount: moveNumber,
          moveHistory,
        }),
        new Promise<Awaited<ReturnType<typeof aiRuntime.analyze>>>((_, reject) => {
          window.setTimeout(() => reject(new Error("KataGo analysis timed out")), 5000);
        }),
      ]);
      if (analysis.error) {
        throw new Error(analysis.error);
      }
      const { scores } = analysis;

      const blackWinrate = aiColor === BLACK ? analysis.winrate : 100 - analysis.winrate;
      winrateHistory.push(blackWinrate);
      winrateEl.textContent = `${blackWinrate.toFixed(1)}%`;

      const rankedMoves = legalMoves
        .map((pos) => ({ pos, score: scores[pos.row * BOARD_SIZE + pos.col] }))
        .sort((a, b) => b.score - a.score);

      const topScore = rankedMoves[0]?.score ?? 0;
      const expScores = rankedMoves.slice(0, 4).map((m) => Math.exp(Math.max(-20, Math.min(20, m.score - topScore))));
      const expSum = expScores.reduce((sum, value) => sum + value, 0) || 1;
      renderCandidates(rankedMoves.slice(0, 4).map((m, i) => ({
        pos: m.pos,
        winrate: (expScores[i] / expSum) * 100,
      })));

      const bestPos = rankedMoves[0]?.pos ?? chooseFallbackMove(legalMoves, aiColor);
      if (bestPos) {
        placeStone(bestPos);
        statusEl.textContent = `AI: ${formatPoint(bestPos)}`;
        pvEl.textContent = `AI: ${formatPoint(bestPos)}`;
      } else {
        passMove();
        statusEl.textContent = "AI passed";
        pvEl.textContent = "AI passed";
      }
    } catch (err) {
      playAiFallbackMove();
      console.warn("KataGo web move failed:", err);
    } finally {
      aiThinking = false;
      boardButton.disabled = false;
    }

    updateUI();
  }

  // ============ Event Handlers ============
  async function handleBoardClick(event: MouseEvent): Promise<void> {
    if (gameOver || aiThinking || currentPlayer !== playerColor) return;

    const rect = boardButton.getBoundingClientRect();
    const boardX = ((event.clientX - rect.left) / rect.width) * 400;
    const boardY = ((event.clientY - rect.top) / rect.height) * 400;
    const col = Math.round((boardX - BOARD_ORIGIN) / GRID_STEP);
    const row = Math.round((boardY - BOARD_ORIGIN) / GRID_STEP);

    if (row < 0 || row >= BOARD_SIZE || col < 0 || col >= BOARD_SIZE) return;

    const pos = { row, col };
    if (!isValidMove(pos)) {
      statusEl.textContent = "Illegal move";
      return;
    }

    placeStone(pos);
    pvEl.textContent = `You: ${formatPoint(pos)}`;
    updateUI();

    if (!gameOver) {
      await aiMove();
    }
  }

  async function handlePass(): Promise<void> {
    if (gameOver || aiThinking || currentPlayer !== playerColor) return;

    passMove();
    pvEl.textContent = "You passed";
    updateUI();

    if (!gameOver) {
      await aiMove();
    }
  }

  function handleResign(): void {
    gameOver = true;
    boardButton.disabled = true;
    statusEl.textContent = "You resigned";
    pvEl.textContent = "AI wins";
  }

  function handlePointerMove(event: MouseEvent): void {
    const rect = boardButton.getBoundingClientRect();
    const boardX = ((event.clientX - rect.left) / rect.width) * 400;
    const boardY = ((event.clientY - rect.top) / rect.height) * 400;
    const col = Math.round((boardX - BOARD_ORIGIN) / GRID_STEP);
    const row = Math.round((boardY - BOARD_ORIGIN) / GRID_STEP);

    if (row < 0 || row >= BOARD_SIZE || col < 0 || col >= BOARD_SIZE ||
        board[row][col] !== EMPTY) {
      hoverStone.setAttribute("cx", "-20");
      hoverStone.setAttribute("cy", "-20");
    } else {
      hoverStone.setAttribute("cx", String(pixelFor(col)));
      hoverStone.setAttribute("cy", String(pixelFor(row)));
    }
  }

  function resetGame(): void {
    board = createEmptyBoard();
    currentPlayer = BLACK;
    koPoint = null;
    passCount = 0;
    gameOver = false;
    lastMove = null;
    playerColor = BLACK;
    aiColor = WHITE;
    moveNumber = 0;
    aiThinking = false;
    moveHistory = [];
    winrateHistory = [50];

    boardButton.disabled = false;
    candidateGroup.innerHTML = "";
    candidateList.innerHTML = "";
    winrateEl.textContent = "50.0%";
    chartLine.setAttribute("d", "");
    chartFill.setAttribute("d", "");
    updateUI();
  }

  // ============ Event Listeners ============
  boardButton?.addEventListener("click", handleBoardClick);
  boardButton?.addEventListener("pointermove", handlePointerMove);
  boardButton?.addEventListener("pointerleave", () => {
    hoverStone.setAttribute("cx", "-20");
    hoverStone.setAttribute("cy", "-20");
  });
  newGameButton?.addEventListener("click", resetGame);
  passButton?.addEventListener("click", handlePass);
  resignButton?.addEventListener("click", handleResign);

  // ============ Boot ============
  async function boot(): Promise<void> {
    statusEl.textContent = "Starting engine...";
    await aiRuntime.init();
    statusEl.textContent = "Loading model...";
    const model = katagoModelUrl ? await aiRuntime.loadModel(katagoModelUrl) : null;
    if (model) {
      modelReady = true;
      modelError = "";
      statusEl.textContent = `${aiRuntime.engineLabel()} loaded`;
    } else {
      modelReady = false;
      modelError = aiRuntime.engineLabel();
      statusEl.textContent = modelError;
      pvEl.textContent = modelError;
    }
    resetGame();
  }

  boot();
</script>
