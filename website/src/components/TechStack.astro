---
import { translations } from "../i18n/translations";
const t = translations;
---

<section class="py-24 px-6 bg-bg-card/30">
  <div class="max-w-4xl mx-auto">
    <!-- EN -->
    <div data-lang="en">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">{t.en.techStack.title}</h2>
    </div>
    <!-- ZH -->
    <div data-lang="zh">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">{t.zh.techStack.title}</h2>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-4">
      {t.en.techStack.items.map((item, i) => (
        <div class="reveal flex items-center gap-3 px-5 py-3 rounded-xl bg-bg-card border border-border hover:border-teal/30 transition-all">
          <!-- EN -->
          <div data-lang="en">
            <span class="text-sm font-semibold text-text-primary">{item.name}</span>
            <span class="text-xs text-text-muted ml-1">· {item.desc}</span>
          </div>
          <!-- ZH -->
          <div data-lang="zh">
            <span class="text-sm font-semibold text-text-primary">{t.zh.techStack.items[i].name}</span>
            <span class="text-xs text-text-muted ml-1">· {t.zh.techStack.items[i].desc}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
