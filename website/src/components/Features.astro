---

<section id="features" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <!-- EN -->
    <div data-lang="en">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-3">{t.en.features.title}</h2>
      <p class="text-text-secondary text-center mb-16 max-w-2xl mx-auto">{t.en.features.subtitle}</p>
    </div>
    <!-- ZH -->
    <div data-lang="zh">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-3">{t.zh.features.title}</h2>
      <p class="text-text-secondary text-center mb-16 max-w-2xl mx-auto">{t.zh.features.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {t.en.features.items.map((item, i) => (
        <div class="reveal group rounded-2xl p-6 bg-bg-card border border-border hover:bg-bg-card-hover hover:border-teal/30 transition-all duration-300 hover:-translate-y-1">
          <!-- EN -->
          <div data-lang="en">
            <div class="w-10 h-10 rounded-xl bg-teal/10 flex items-center justify-center text-teal mb-4 group-hover:bg-teal/20 transition-colors" set:html={icons[item.icon]} />
            <h3 class="text-base font-semibold mb-2">{item.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{item.description}</p>
          </div>
          <!-- ZH -->
          <div data-lang="zh">
            <div class="w-10 h-10 rounded-xl bg-teal/10 flex items-center justify-center text-teal mb-4 group-hover:bg-teal/20 transition-colors" set:html={icons[t.zh.features.items[i].icon]} />
            <h3 class="text-base font-semibold mb-2">{t.zh.features.items[i].title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{t.zh.features.items[i].description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
