---
import { translations } from "../i18n/translations";
const t = translations;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<nav class="fixed top-0 left-0 right-0 z-50 glass">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="#" class="flex items-center gap-3 group">
      <img
        src={`${base}/logo.png`}
        alt="React Go"
        class="w-8 h-8 rounded-lg transition-transform group-hover:scale-110"
      />
      <span class="text-lg font-bold tracking-tight gradient-text">React Go</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-8">
      <a
        href="#features"
        class="text-sm text-text-secondary hover:text-text-primary transition-colors"
        data-lang="en"
      >{t.en.nav.features}</a>
      <a
        href="#features"
        class="text-sm text-text-secondary hover:text-text-primary transition-colors"
        data-lang="zh"
      >{t.zh.nav.features}</a>

      <a
        href="#ai"
        class="text-sm text-text-secondary hover:text-text-primary transition-colors"
        data-lang="en"
      >{t.en.nav.ai}</a>
      <a
        href="#ai"
        class="text-sm text-text-secondary hover:text-text-primary transition-colors"
        data-lang="zh"
      >{t.zh.nav.ai}</a>

      <a
        href="#download"
        class="text-sm text-text-secondary hover:text-text-primary transition-colors"
        data-lang="en"
      >{t.en.nav.download}</a>
      <a
        href="#download"
        class="text-sm text-text-secondary hover:text-text-primary transition-colors"
        data-lang="zh"
      >{t.zh.nav.download}</a>

      <a
        href="https://github.com/Neonity2020/react-go"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-text-secondary hover:text-text-primary transition-colors"
      >GitHub</a>

      <button
        id="lang-toggle"
        class="px-3 py-1 text-sm rounded-lg bg-glass border border-glass-border text-text-secondary hover:text-text-primary transition-colors cursor-pointer"
      >
        中
      </button>
    </div>

    <!-- Mobile Menu -->
    <div class="md:hidden flex items-center gap-3">
      <button
        id="lang-toggle"
        class="px-3 py-1 text-sm rounded-lg bg-glass border border-glass-border text-text-secondary hover:text-text-primary transition-colors cursor-pointer"
      >
        中
      </button>
      <a
        href="https://github.com/Neonity2020/react-go"
        target="_blank"
        rel="noopener noreferrer"
        class="text-text-secondary hover:text-text-primary transition-colors"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
    </div>
  </div>
</nav>
