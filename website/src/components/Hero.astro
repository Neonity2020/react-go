---
import { translations } from "../i18n/translations";
const t = translations;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-16">
  <!-- Background gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-bg-dark via-bg-dark to-bg-card/50"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-teal/5 rounded-full blur-[120px]"></div>

  <!-- Floating stones decoration -->
  <div class="absolute top-32 left-[10%] animate-float opacity-20">
    <svg width="48" height="48" viewBox="0 0 48 48">
      <radialGradient id="bs1" cx="40%" cy="35%">
        <stop offset="0%" stop-color="#555" />
        <stop offset="100%" stop-color="#111" />
      </radialGradient>
      <circle cx="24" cy="24" r="22" fill="url(#bs1)" />
    </svg>
  </div>
  <div class="absolute bottom-40 right-[12%] animate-float-delay opacity-20">
    <svg width="40" height="40" viewBox="0 0 40 40">
      <radialGradient id="ws1" cx="35%" cy="30%">
        <stop offset="0%" stop-color="#fff" />
        <stop offset="80%" stop-color="#c8c4bc" />
      </radialGradient>
      <circle cx="20" cy="20" r="18" fill="url(#ws1)" />
    </svg>
  </div>
  <div class="absolute top-48 right-[25%] animate-float opacity-10">
    <svg width="32" height="32" viewBox="0 0 32 32">
      <radialGradient id="bs2" cx="40%" cy="35%">
        <stop offset="0%" stop-color="#555" />
        <stop offset="100%" stop-color="#111" />
      </radialGradient>
      <circle cx="16" cy="16" r="14" fill="url(#bs2)" />
    </svg>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto px-6 py-20 flex flex-col lg:flex-row items-center gap-16">
    <!-- Text -->
    <div class="flex-1 text-center lg:text-left">
      <!-- EN -->
      <div data-lang="en">
        <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-4">
          <span class="gradient-text">{t.en.hero.headline}</span>
        </h1>
        <p class="text-xl md:text-2xl text-text-secondary mb-4 font-medium">
          {t.en.hero.subtitle}
        </p>
        <p class="text-base text-text-muted max-w-lg mx-auto lg:mx-0 mb-8 leading-relaxed">
          {t.en.hero.description}
        </p>
      </div>
      <!-- ZH -->
      <div data-lang="zh">
        <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-4">
          <span class="gradient-text">{t.zh.hero.headline}</span>
        </h1>
        <p class="text-xl md:text-2xl text-text-secondary mb-4 font-medium">
          {t.zh.hero.subtitle}
        </p>
        <p class="text-base text-text-muted max-w-lg mx-auto lg:mx-0 mb-8 leading-relaxed">
          {t.zh.hero.description}
        </p>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
        <a
          href="https://github.com/Neonity2020/react-go/releases/latest"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-teal hover:bg-teal-light text-white font-semibold text-base transition-all shadow-lg shadow-teal/25 hover:shadow-teal/40"
          data-lang="en"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          {t.en.hero.downloadBtn}
        </a>
        <a
          href="https://github.com/Neonity2020/react-go/releases/latest"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-teal hover:bg-teal-light text-white font-semibold text-base transition-all shadow-lg shadow-teal/25 hover:shadow-teal/40"
          data-lang="zh"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          {t.zh.hero.downloadBtn}
        </a>

        <a
          href="https://github.com/Neonity2020/react-go"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl border border-border text-text-secondary hover:text-text-primary hover:border-text-muted font-medium text-base transition-all"
          data-lang="en"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          {t.en.hero.githubBtn}
        </a>
        <a
          href="https://github.com/Neonity2020/react-go"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl border border-border text-text-secondary hover:text-text-primary hover:border-text-muted font-medium text-base transition-all"
          data-lang="zh"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          {t.zh.hero.githubBtn}
        </a>
      </div>

      <!-- Size note -->
      <div data-lang="en">
        <p class="mt-4 text-sm text-text-muted">{t.en.hero.sizeNote}</p>
      </div>
      <div data-lang="zh">
        <p class="mt-4 text-sm text-text-muted">{t.zh.hero.sizeNote}</p>
      </div>
    </div>

    <!-- Board Illustration -->
    <div class="flex-1 max-w-md w-full">
      <svg viewBox="0 0 400 400" class="w-full drop-shadow-2xl" style="border-radius: 12px;">
        <!-- Board background -->
        <defs>
          <linearGradient id="boardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#e7bf72" />
            <stop offset="100%" stop-color="#c89345" />
          </linearGradient>
          <radialGradient id="blackStone" cx="40%" cy="35%">
            <stop offset="0%" stop-color="#555" />
            <stop offset="100%" stop-color="#111" />
          </radialGradient>
          <radialGradient id="whiteStone" cx="35%" cy="30%">
            <stop offset="0%" stop-color="#fff" />
            <stop offset="80%" stop-color="#c8c4bc" />
          </radialGradient>
          <filter id="stoneShadow">
            <feDropShadow dx="1" dy="2" stdDeviation="2" flood-opacity="0.3" />
          </filter>
        </defs>

        <rect width="400" height="400" rx="12" fill="url(#boardGrad)" />

        <!-- Grid lines (9x9) -->
        {Array.from({ length: 9 }, (_, i) => {
          const pos = 50 + i * 37.5;
          return (
            <>
              <line x1={pos} y1="50" x2={pos} y2="350" stroke="#8B6B2F" stroke-width="0.8" />
              <line x1="50" y1={pos} x2="350" y2={pos} stroke="#8B6B2F" stroke-width="0.8" />
            </>
          );
        })}

        <!-- Star points -->
        {[125, 275].map((x) =>
          [125, 275].map((y) => (
            <circle cx={x} cy={y} r="3.5" fill="#8B6B2F" />
          ))
        )}
        <circle cx="200" cy="200" r="3.5" fill="#8B6B2F" />

        <!-- Stones — a realistic mid-game position -->
        <circle cx="200" cy="200" r="16" fill="url(#blackStone)" filter="url(#stoneShadow)" />
        <circle cx="162.5" cy="162.5" r="16" fill="url(#whiteStone)" filter="url(#stoneShadow)" />
        <circle cx="237.5" cy="237.5" r="16" fill="url(#whiteStone)" filter="url(#stoneShadow)" />
        <circle cx="162.5" cy="237.5" r="16" fill="url(#blackStone)" filter="url(#stoneShadow)" />
        <circle cx="275" cy="162.5" r="16" fill="url(#blackStone)" filter="url(#stoneShadow)" />
        <circle cx="125" cy="200" r="16" fill="url(#whiteStone)" filter="url(#stoneShadow)" />
        <circle cx="200" cy="125" r="16" fill="url(#blackStone)" filter="url(#stoneShadow)" />
        <circle cx="237.5" cy="162.5" r="16" fill="url(#whiteStone)" filter="url(#stoneShadow)" />
        <circle cx="200" cy="275" r="16" fill="url(#blackStone)" filter="url(#stoneShadow)" />
        <circle cx="275" cy="200" r="16" fill="url(#whiteStone)" filter="url(#stoneShadow)" />

        <!-- Last move marker -->
        <circle cx="200" cy="200" r="5" fill="none" stroke="white" stroke-width="1.5" />
      </svg>
    </div>
  </div>
</section>
